// File: contracts/IDelegatory.sol



interface IDelegation {
    function run() external;
}

contract Delegation {

    address transient delegation;

    function create(bytes32 salt, bytes calldata creationCode) public returns (address) {
        require(address(this) == msg.sender);
        return Create2.deploy(0, salt, creationCode);
    }

    function run(address target) payable public {
        require(address(this) == msg.sender);
        delegation = target;
        delegate(abi.encodeWithSelector(IDelegation.run.selector));
    }

    function delegate(bytes memory _data) internal {
        address _delegation = delegation;
        if (_delegation == address(0)) {
            return;
        }
        uint256 length = _data.length;
        assembly("memory-safe") {
            if iszero(delegatecall(gas(), _delegation, _data, length, 0x0, 0x20)) {
                revert(0x0, returndatasize())
            }
        }
    }

    function createAndRun(bytes32 salt, bytes calldata creationCode) payable public {
        require(address(this) == msg.sender);
        run(create(salt, creationCode));
    }

    fallback() external payable {
        delegate(msg.data);
    }

    receive() external payable {
        delegate(hex"");
    }
}