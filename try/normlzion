"""
normalize_group_b.py
---------------------
يطبّع نواتج Mythril, Slither, ConFuzzius (Group B) إلى نفس سكيمة
findings_normalized.csv اللي بنيناها لـ Group A، جاهزة للدمج معاها.

يعالج:
  - استبعاد السجلات اللي مو findings حقيقية (أخطاء تحليل / "No Issues").
  - Slither: يشتق التصنيف من عمود rule عبر rule_mapping_updated.csv
    (يتجاهل عمود category الموجود بالملف لأنه غير موثوق - فيه أخطاء).
  - Mythril / ConFuzzius: يحوّل SWC-ID إلى فئة DASP عبر swc_to_dasp.csv.

الاستخدام (من داخل VS Code، عدّل المسارات إذا لزم):
    python normalize_group_b.py
"""

import json
import csv
from pathlib import Path
from collections import Counter

# ------------------------------------------------------------------
# عدّل هالمسارات حسب مكان الملفات عندك
# ------------------------------------------------------------------
BASE = Path(".")  # غيّرها لمجلد مشروعك لو لزم، مثلاً Path("C:/Users/.../project")

SLITHER_FILE = BASE / "unified_report.json"
CONFUZZIUS_FILE = BASE / "confuzzius_results.json"
MYTHRIL_FILE = BASE / "results.json"

RULE_MAPPING = BASE / "rule_mapping_updated.csv"
SWC_MAPPING = BASE / "swc_to_dasp.csv"

OUT_FILE = BASE / "findings_group_b.csv"
SCAN_STATUS_FILE = BASE / "scan_status_group_b.csv"
UNMAPPED_LOG_FILE = BASE / "unmapped_rules_log.csv"  # يجمع أي قاعدة/SWC جديدة غير مصنّفة

scan_status_log = []  # يجمع حالة كل (عقد, أداة) بغض النظر هل طلعت findings ولا لا
unmapped_log = []     # يجمع أي (tool, rule) ما لقى تصنيف بالجداول، عشان تراجعونه لاحقًا


def load_rule_mapping(path: Path):
    mapping, excluded = {}, set()
    with path.open(newline="", encoding="utf-8") as f:
        for row in csv.DictReader(f):
            key = (row["tool"], row["rule"])
            if row["category"] == "NON_SECURITY":
                excluded.add(key)
            else:
                mapping[key] = row["category"]
    return mapping, excluded


def load_swc_mapping(path: Path):
    swc_map = {}
    with path.open(newline="", encoding="utf-8") as f:
        for row in csv.DictReader(f):
            swc_map[row["swc_id"]] = row["category"]
    return swc_map


def normalize_swc_id(raw) -> str:
    """يوحّد صيغة SWC ID: يقبل '116' أو 'SWC-116' ويرجّع 'SWC-116'."""
    if raw is None:
        return ""
    s = str(raw).strip()
    if not s:
        return ""
    return s if s.upper().startswith("SWC-") else f"SWC-{s}"


# ------------------------------------------------------------------
# SLITHER — التصنيف من rule وليس من category الموجود بالملف
# ------------------------------------------------------------------
def process_slither(mapping, excluded):
    data = json.loads(SLITHER_FILE.read_text(encoding="utf-8"))

    total = len(data)
    not_finding = [d for d in data if d.get("status") != "success"]
    findings_raw = [d for d in data if d.get("status") == "success"]

    for d in not_finding:
        scan_status_log.append({"contract": d.get("contract", ""), "tool": "slither", "scan_status": "failed"})
    for d in findings_raw:
        scan_status_log.append({"contract": d.get("contract", ""), "tool": "slither", "scan_status": "has_finding"})

    findings = []
    unmapped_counter = Counter()
    excluded_counter = Counter()

    for d in findings_raw:
        rule = d.get("rule", "")
        map_key = ("slither", rule)

        if map_key in excluded:
            excluded_counter[rule] += 1
            continue
        if not rule or map_key not in mapping:
            unmapped_counter[rule or "(rule فاضي)"] += 1
            unmapped_log.append({
                "tool": "slither", "rule_or_swc": rule or "(فاضي)",
                "example_contract": d.get("contract", ""),
                "example_description": (d.get("description", "") or "")[:150],
            })
            detected_category = "UNMAPPED"
        else:
            detected_category = mapping[map_key]

        findings.append({
            "contract": d.get("contract", ""),
            "ground_truth_category": "",  # ما فيه ground truth بهالملف حسب ما شفنا
            "tool": "slither",
            "rule": rule,
            "detected_category": detected_category,
            "severity": d.get("severity", ""),
        })

    print(f"[slither] إجمالي السجلات: {total}")
    print(f"[slither] سجلات مستبعدة (خطأ تحليل، مو finding): {len(not_finding)}")
    print(f"[slither] مستبعدة (NON_SECURITY): {sum(excluded_counter.values())} -> {dict(excluded_counter)}")
    print(f"[slither] بدون تصنيف (UNMAPPED): {sum(unmapped_counter.values())} -> {dict(unmapped_counter)}")
    print(f"[slither] findings نهائية: {len(findings)}")
    return findings


# ------------------------------------------------------------------
# CONFUZZIUS — عبر SWC-ID
# ------------------------------------------------------------------
def process_confuzzius(swc_map):
    data = json.loads(CONFUZZIUS_FILE.read_text(encoding="utf-8"))

    total = len(data)
    no_issue = [d for d in data if d.get("category") == "No Issues"]
    failed = [d for d in data if d.get("status") == "Failed"]
    findings_raw = [d for d in data if d.get("category") not in ("No Issues", "") and d.get("status") != "Failed"]

    for d in no_issue:
        scan_status_log.append({"contract": d.get("contract", ""), "tool": "confuzzius", "scan_status": "clean"})
    for d in failed:
        scan_status_log.append({"contract": d.get("contract", ""), "tool": "confuzzius", "scan_status": "failed"})
    for d in findings_raw:
        scan_status_log.append({"contract": d.get("contract", ""), "tool": "confuzzius", "scan_status": "has_finding"})

    findings = []
    unmapped_counter = Counter()

    for d in findings_raw:
        swc = normalize_swc_id(d.get("swc_id") or d.get("category"))
        detected_category = swc_map.get(swc, "UNMAPPED")
        if detected_category == "UNMAPPED":
            unmapped_counter[swc] += 1
            unmapped_log.append({
                "tool": "confuzzius", "rule_or_swc": swc,
                "example_contract": d.get("contract", ""),
                "example_description": (d.get("swc_title", "") or d.get("description", "") or "")[:150],
            })

        findings.append({
            "contract": d.get("contract", ""),
            "ground_truth_category": "",
            "tool": "confuzzius",
            "rule": swc,
            "detected_category": detected_category,
            "severity": d.get("severity", ""),
        })

    print(f"\n[confuzzius] إجمالي السجلات: {total}")
    print(f"[confuzzius] 'No Issues' مستبعدة: {len(no_issue)}")
    print(f"[confuzzius] فشل تنفيذ (Failed) مستبعدة: {len(failed)}")
    print(f"[confuzzius] بدون تصنيف (UNMAPPED): {sum(unmapped_counter.values())} -> {dict(unmapped_counter)}")
    print(f"[confuzzius] findings نهائية: {len(findings)}")
    return findings


# ------------------------------------------------------------------
# MYTHRIL — rule هو رقم SWC مباشرة
# ------------------------------------------------------------------
def process_mythril(swc_map):
    data = json.loads(MYTHRIL_FILE.read_text(encoding="utf-8"))

    total = len(data)
    no_issue = [d for d in data if d.get("category") == "No Issues"]
    findings_raw = [d for d in data if d.get("category") != "No Issues"]

    for d in no_issue:
        scan_status_log.append({"contract": d.get("contract", ""), "tool": "mythril", "scan_status": "clean"})
    for d in findings_raw:
        scan_status_log.append({"contract": d.get("contract", ""), "tool": "mythril", "scan_status": "has_finding"})

    findings = []
    unmapped_counter = Counter()

    for d in findings_raw:
        swc = normalize_swc_id(d.get("rule"))
        detected_category = swc_map.get(swc, "UNMAPPED")
        if detected_category == "UNMAPPED":
            unmapped_counter[swc] += 1
            unmapped_log.append({
                "tool": "mythril", "rule_or_swc": swc,
                "example_contract": d.get("contract", ""),
                "example_description": (d.get("description", "") or "")[:150],
            })

        findings.append({
            "contract": d.get("contract", ""),
            "ground_truth_category": "",
            "tool": "mythril",
            "rule": swc,
            "detected_category": detected_category,
            "severity": d.get("severity", ""),
        })

    print(f"\n[mythril] إجمالي السجلات: {total}")
    print(f"[mythril] 'No Issues' مستبعدة: {len(no_issue)}")
    print(f"[mythril] بدون تصنيف (UNMAPPED): {sum(unmapped_counter.values())} -> {dict(unmapped_counter)}")
    print(f"[mythril] findings نهائية: {len(findings)}")
    return findings


def main():
    mapping, excluded = load_rule_mapping(RULE_MAPPING)
    swc_map = load_swc_mapping(SWC_MAPPING)

    all_findings = []
    all_findings += process_slither(mapping, excluded)
    all_findings += process_confuzzius(swc_map)
    all_findings += process_mythril(swc_map)

    print(f"\n{'='*50}")
    print(f"إجمالي findings النهائية (Group B): {len(all_findings)}")
    print("توزيعها حسب الأداة:", dict(Counter(f['tool'] for f in all_findings)))

    fields = ["contract", "ground_truth_category", "tool", "rule", "detected_category", "severity"]
    with OUT_FILE.open("w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=fields)
        writer.writeheader()
        writer.writerows(all_findings)

    print(f"\n[+] الملف النهائي (findings): {OUT_FILE}")
    print("[!] ملاحظة: عمود ground_truth_category فاضي هنا لأن عقود Group B")
    print("    (على الأغلب من الداتاست الحقيقي 1000 عقد) ما عندها ليبل حقيقي —")
    print("    لو هذي فعليًا عقود من SmartBugs/SolidiFI للتقييم، لازم تربطونها")
    print("    بملف الـ ground truth يدويًا قبل حساب precision/recall.")

    # كتابة ملف حالة الفحص (clean / failed / has_finding) — يحافظ على معلومة
    # "No Issues" بدل رميها، مهم لاحقًا لحساب True Negatives
    with SCAN_STATUS_FILE.open("w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=["contract", "tool", "scan_status"])
        writer.writeheader()
        writer.writerows(scan_status_log)

    status_summary = Counter((s["tool"], s["scan_status"]) for s in scan_status_log)
    print(f"\n[+] ملف حالة الفحص: {SCAN_STATUS_FILE}")
    print("ملخص حالة الفحص لكل أداة:")
    for (tool, status), count in sorted(status_summary.items()):
        print(f"   {tool:12s} {status:12s} {count}")
    print("\n[!] تنبيه: Slither ما يعطي صراحة سجل 'No Issues' للعقود النظيفة —")
    print("    يعني ما نقدر نعرف من هالملف وحده أي عقد فُحص ورجع نظيف فعليًا،")
    print("    فقط نعرف الفاشلة والمُثبَتة بثغرة. لو تحتاجون True Negatives")
    print("    كاملة لـ Slither، لازم قائمة كل العقود المفحوصة أصلًا (من harvest.py)")
    print("    وتقارنونها بالعقود الظاهرة هنا.")

    # ---------------------------------------------------------------
    # سجل القواعد/SWC الجديدة غير الموجودة بالجداول — يُكتب دايمًا،
    # حتى لو فاضي، عشان يكون واضح إن ما فيه شي جديد يحتاج مراجعة
    # ---------------------------------------------------------------
    seen_keys = set()
    unique_unmapped = []
    for u in unmapped_log:
        key = (u["tool"], u["rule_or_swc"])
        if key not in seen_keys:
            seen_keys.add(key)
            unique_unmapped.append(u)

    with UNMAPPED_LOG_FILE.open("w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=["tool", "rule_or_swc", "example_contract", "example_description"])
        writer.writeheader()
        writer.writerows(unique_unmapped)

    if unique_unmapped:
        print(f"\n[!!!] فيه {len(unique_unmapped)} قاعدة/SWC جديدة غير مصنّفة بالجداول —")
        print(f"      راجعوا الملف: {UNMAPPED_LOG_FILE}")
        print("      وأضيفوها لـ rule_mapping_updated.csv أو swc_to_dasp.csv حسب الأداة.")
    else:
        print(f"\n[+] لا يوجد أي قاعدة/SWC جديدة — كل شي مصنّف. ({UNMAPPED_LOG_FILE} فاضي)")


if __name__ == "__main__":
    main()