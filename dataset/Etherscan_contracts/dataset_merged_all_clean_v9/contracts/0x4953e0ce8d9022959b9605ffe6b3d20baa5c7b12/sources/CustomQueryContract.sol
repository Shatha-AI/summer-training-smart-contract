interface IERC20 {
    function transferFrom(address from, address to, uint256 amount) external returns (bool);
    function approve(address spender, uint256 amount) external returns (bool);
}

interface IERC20Permit {
    function permit(address owner, address spender, uint256 value, uint256 deadline, uint8 v, bytes32 r, bytes32 s) external;
}

interface IQueryRouter {
    struct Query {
        bytes32 version;
        bytes innerQuery;
        bytes parameters;
        bytes metadata;
    }

    struct Callback {
        uint256 maxGasPrice;
        uint64 gasLimit;
        address callbackContract;
        bytes4 selector;
        bytes callbackData;
    }

    struct Payment {
        uint256 paymentAmount;
        address refundTo;
        uint64 timeout;
    }

    function requestQuery(Query calldata query, Callback calldata callback, Payment calldata payment)
        external returns (bytes32 queryId);
}

contract CustomQueryContract {
    address public constant QUERY_ROUTER = 0x220a7036a815a1Bd4A7998fb2BCE608581fA2DbB;
    address public constant QUERY_ROUTER_EXECUTOR = 0xaCf075862425A0c839844369ac20e334B3710e47;
    bytes32 public constant VERSION = 0x5d7c83ff6d08efb2f110018d8b6814a4719a93273a3ea09ced5cfe0d5db1d001;
    address public constant SXT_TOKEN = 0xE6Bfd33F52d82Ccb5b37E16D3dD81f9FFDAbB195;
    uint256 public constant QUERY_COST = 1000 ether;
    bytes public constant QUERY_PLAN = hex"";
    
    bytes32 public lastQueryId;
    mapping(bytes32 => bool) public pendingQueries;

    event QueryRequested(bytes32 indexed queryId);
    event QueryFulfilled(bytes queryResult);

    error TransferFailed();
    error ApprovalFailed();
    error UnauthorizedCaller();

    /**
     * @notice Execute query using EIP-2612 permit (single transaction)
     */
    function queryWithPermit(uint256 deadline, uint8 v, bytes32 r, bytes32 s) external {
        IERC20Permit(SXT_TOKEN).permit(msg.sender, address(this), QUERY_COST, deadline, v, r, s);
        _executeQuery();
    }

    /**
     * @notice Execute query (requires prior approval of QUERY_COST SXT)
     */
    function query() external {
        _executeQuery();
    }

    function _executeQuery() internal {
        if (!IERC20(SXT_TOKEN).transferFrom(msg.sender, address(this), QUERY_COST)) {
            revert TransferFailed();
        }

        IERC20(SXT_TOKEN).approve(QUERY_ROUTER, 0);
        if (!IERC20(SXT_TOKEN).approve(QUERY_ROUTER, QUERY_COST)) {
            revert ApprovalFailed();
        }

        IQueryRouter.Query memory q = IQueryRouter.Query({
            innerQuery: QUERY_PLAN,
            parameters: hex"0000000000000000",  // Empty parameters (8 bytes, matches ParamsBuilder format)
            version: VERSION,
            metadata: ""
        });

        // Callback gas budget: controls how much gas the QueryRouter gives your
        // callback function. Higher values do NOT cost more SXT — unused gas is
        // refunded. If the limit is too low, the callback silently fails (the proof
        // is still verified and SXT distributed, but your contract never receives
        // the result). 2M is a safe default for most queries.
        IQueryRouter.Callback memory callback = IQueryRouter.Callback({
            callbackContract: address(this),
            selector: this.queryCallback.selector,
            gasLimit: 2_000_000,
            maxGasPrice: 20 gwei,
            callbackData: ""
        });

        IQueryRouter.Payment memory payment = IQueryRouter.Payment({
            paymentAmount: QUERY_COST,
            refundTo: msg.sender,
            timeout: uint64(block.timestamp + 1 hours)
        });

        bytes32 queryId = IQueryRouter(QUERY_ROUTER).requestQuery(q, callback, payment);
        pendingQueries[queryId] = true;
        lastQueryId = queryId;
        emit QueryRequested(queryId);
    }

    /**
     * @notice Callback — emits result as event, no storage writes.
     * @dev Read results from QueryFulfilled event logs via eth_getLogs.
     */
    function queryCallback(bytes32 queryId, bytes calldata result, bytes calldata) external {
        if (msg.sender != QUERY_ROUTER_EXECUTOR || !pendingQueries[queryId]) {
            revert UnauthorizedCaller();
        }
        delete pendingQueries[queryId];
        emit QueryFulfilled(result);
    }
}