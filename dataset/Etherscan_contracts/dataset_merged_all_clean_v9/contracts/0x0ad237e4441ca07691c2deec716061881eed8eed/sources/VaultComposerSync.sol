    constructor(address _vault, address _assetOFT, address _shareOFT) {
        VAULT = IERC4626(_vault);

        SHARE_OFT = _shareOFT;
        ASSET_OFT = _assetOFT;

        SHARE_ERC20 = _initializeShareToken();
        ASSET_ERC20 = _initializeAssetToken();

