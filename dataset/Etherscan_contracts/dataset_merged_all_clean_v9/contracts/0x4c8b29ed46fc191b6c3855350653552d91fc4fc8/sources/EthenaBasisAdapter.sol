// src/interfaces/IVenueAdapter.sol

/// @notice Minimal interface every venue adapter must implement.
/// An adapter wraps ONE whitelisted protocol position (e.g. Aave v3 USDC,
/// a Pendle PT market, a Uniswap v3 range) and is the only thing the vault
/// talks to. Adapters hold their positions on behalf of the vault and can
/// only ever return funds to the vault.
interface IVenueAdapter {
    /// @notice The underlying asset (must match the vault's asset).
    function asset() external view returns (address);

    /// @notice Current value of this adapter's position, in asset units.
    function totalAssets() external view returns (uint256);

    /// @notice Pull `assets` from the vault (transferFrom) and deploy them.
    function deposit(uint256 assets) external;

    /// @notice Unwind up to `assets` and send them back to the vault.
    /// @return withdrawn The amount actually returned (≤ assets).
    function withdraw(uint256 assets) external returns (uint256 withdrawn);
}

