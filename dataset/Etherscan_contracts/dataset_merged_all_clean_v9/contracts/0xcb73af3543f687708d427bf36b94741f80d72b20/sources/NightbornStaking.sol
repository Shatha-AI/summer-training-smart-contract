// File contracts/NightbornStaking.sol

// Original license: SPDX_License_Identifier: MIT
pragma solidity ^0.8.27;






using ECDSA for bytes32;

contract NightbornStaking is Ownable2Step, Pausable, ReentrancyGuard, IERC721Receiver {
    struct LockTier {
        uint32 durationSeconds;
        uint16 multiplierBps;
    }

    struct StakeInfo {
        address owner;
        uint64 stakedAt;
        uint64 unlocksAt;
        uint16 typeMultiplierBps;
        uint16 lockMultiplierBps;
        bool active;
    }

    uint256 public constant MAX_BATCH_SIZE = 50;
    uint256 public constant NUM_LOCK_TIERS = 5;

    IERC721 public immutable nftContract;

    LockTier[NUM_LOCK_TIERS] public lockTiers;
    address public signer;
    bool public emergencyUnlockEnabled;

    mapping(uint256 => StakeInfo) public stakes;
    mapping(bytes32 => bool) public usedAttestations;

    event Staked(
        address indexed owner,
        uint256 indexed tokenId,
        uint8 lockTierIndex,
        uint8 typeIndex,
        uint256 stakedAt,
        uint256 unlocksAt
    );
    event Unstaked(address indexed owner, uint256 indexed tokenId, uint256 unstakedAt);
    event SignerUpdated(address indexed oldSigner, address indexed newSigner);
    event EmergencyUnlockEnabled(uint256 timestamp);
    event LockTierUpdated(uint8 index, uint32 durationSeconds, uint16 multiplierBps);
    event AdminForceUnstake(address indexed owner, uint256 indexed tokenId, uint256 timestamp);

    error ArrayLengthMismatch();
    error EmptyBatch();
    error BatchTooLarge();
    error InvalidLockTierIndex();
    error AttestationExpired();
    error AttestationAlreadyUsed();
    error InvalidSignature();
    error NotTokenOwner();
    error AlreadyStaked();
    error NotApprovedForAll();
    error NotActiveStake();
    error NotOriginalStaker();
    error LockNotMatured();

    constructor(address _nftContract, address _signer, address _initialOwner) Ownable(_initialOwner) {
        nftContract = IERC721(_nftContract);
        signer = _signer;

        lockTiers[0] = LockTier({durationSeconds: 7 days, multiplierBps: 10000});
        lockTiers[1] = LockTier({durationSeconds: 15 days, multiplierBps: 12500});
        lockTiers[2] = LockTier({durationSeconds: 30 days, multiplierBps: 15000});
        lockTiers[3] = LockTier({durationSeconds: 90 days, multiplierBps: 18500});
        lockTiers[4] = LockTier({durationSeconds: 180 days, multiplierBps: 23500});
    }

    function isStaked(uint256 tokenId) external view returns (bool) {
        return stakes[tokenId].active;
    }

    function getLockTier(uint8 index) external view returns (LockTier memory) {
        return lockTiers[index];
    }

    function stake(
        uint256[] calldata tokenIds,
        uint8[] calldata lockTierIndices,
        uint8[] calldata typeIndices,
        uint256[] calldata deadlines,
        bytes[] calldata signatures
    ) external whenNotPaused nonReentrant {
        uint256 len = tokenIds.length;
        if (len == 0) revert EmptyBatch();
        if (len > MAX_BATCH_SIZE) revert BatchTooLarge();
        if (
            lockTierIndices.length != len ||
            typeIndices.length != len ||
            deadlines.length != len ||
            signatures.length != len
        ) revert ArrayLengthMismatch();

        for (uint256 i = 0; i < len; i++) {
            uint256 tokenId = tokenIds[i];
            uint8 lockTierIndex = lockTierIndices[i];
            uint8 typeIndex = typeIndices[i];
            uint256 deadline = deadlines[i];

            if (lockTierIndex >= NUM_LOCK_TIERS) revert InvalidLockTierIndex();
            if (block.timestamp > deadline) revert AttestationExpired();
            if (stakes[tokenId].owner != address(0)) revert AlreadyStaked();
            if (nftContract.ownerOf(tokenId) != msg.sender) revert NotTokenOwner();
            if (!nftContract.isApprovedForAll(msg.sender, address(this))) revert NotApprovedForAll();

            bytes32 hash = keccak256(
                abi.encodePacked(msg.sender, tokenId, typeIndex, deadline, address(this))
            );
            if (usedAttestations[hash]) revert AttestationAlreadyUsed();

            address recovered = hash.recover(signatures[i]);
            if (recovered != signer) revert InvalidSignature();

            usedAttestations[hash] = true;

            LockTier memory tier = lockTiers[lockTierIndex];
            uint64 stakedAt = uint64(block.timestamp);
            uint64 unlocksAt = uint64(block.timestamp + tier.durationSeconds);

            stakes[tokenId] = StakeInfo({
                owner: msg.sender,
                stakedAt: stakedAt,
                unlocksAt: unlocksAt,
                typeMultiplierBps: _typeMultiplierBps(typeIndex),
                lockMultiplierBps: tier.multiplierBps,
                active: true
            });

            emit Staked(msg.sender, tokenId, lockTierIndex, typeIndex, stakedAt, unlocksAt);

            nftContract.transferFrom(msg.sender, address(this), tokenId);
        }
    }

    function unstake(uint256[] calldata tokenIds) external nonReentrant {
        uint256 len = tokenIds.length;
        if (len == 0) revert EmptyBatch();
        if (len > MAX_BATCH_SIZE) revert BatchTooLarge();

        for (uint256 i = 0; i < len; i++) {
            uint256 tokenId = tokenIds[i];
            StakeInfo memory info = stakes[tokenId];

            if (!info.active) revert NotActiveStake();
            if (info.owner != msg.sender) revert NotOriginalStaker();
            if (!emergencyUnlockEnabled && block.timestamp < info.unlocksAt) revert LockNotMatured();

            address originalStaker = info.owner;

            delete stakes[tokenId];

            emit Unstaked(originalStaker, tokenId, block.timestamp);

            nftContract.transferFrom(address(this), originalStaker, tokenId);
        }
    }

    function setSigner(address newSigner) external onlyOwner {
        emit SignerUpdated(signer, newSigner);
        signer = newSigner;
    }

    function setPaused(bool state) external onlyOwner {
        if (state) _pause();
        else _unpause();
    }

    function setLockTier(uint8 index, uint32 durationSeconds, uint16 multiplierBps) external onlyOwner {
        if (index >= NUM_LOCK_TIERS) revert InvalidLockTierIndex();
        lockTiers[index] = LockTier({durationSeconds: durationSeconds, multiplierBps: multiplierBps});
        emit LockTierUpdated(index, durationSeconds, multiplierBps);
    }

    function enableEmergencyUnlock() external onlyOwner {
        emergencyUnlockEnabled = true;
        emit EmergencyUnlockEnabled(block.timestamp);
    }

    function adminForceUnstake(uint256 tokenId) external onlyOwner nonReentrant {
        StakeInfo memory info = stakes[tokenId];
        if (!info.active) revert NotActiveStake();

        address originalStaker = info.owner;
        delete stakes[tokenId];

        emit AdminForceUnstake(originalStaker, tokenId, block.timestamp);
        emit Unstaked(originalStaker, tokenId, block.timestamp);

        nftContract.transferFrom(address(this), originalStaker, tokenId);
    }

    function _typeMultiplierBps(uint8 typeIndex) internal pure returns (uint16) {
        if (typeIndex == 0) return 10000;
        if (typeIndex == 1) return 12500;
        if (typeIndex == 2) return 15000;
        revert("NightbornStaking: invalid typeIndex");
    }

    function onERC721Received(
        address,
        address,
        uint256,
        bytes calldata
    ) external pure override returns (bytes4) {
        return IERC721Receiver.onERC721Received.selector;
    }
}