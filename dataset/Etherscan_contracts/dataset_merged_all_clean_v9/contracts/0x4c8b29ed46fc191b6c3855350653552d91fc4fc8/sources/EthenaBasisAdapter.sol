// src/adapters/EthenaBasisAdapter.sol

/// @notice Curve-style StableSwap (USDC ⇄ USDe), 2-coin pool.
interface ICurveStableSwap {
    function exchange(int128 i, int128 j, uint256 dx, uint256 minDy)
        external returns (uint256);
    function coins(uint256 i) external view returns (address);
}

/// @notice Ethena StakedUSDe (sUSDe): an ERC-4626 vault on USDe, plus a
/// cooldown queue for unstaking. `cooldownDuration()==0` means instant redeem.
interface IStakedUSDe is IERC4626 {
    function cooldownDuration() external view returns (uint24);
    function cooldownShares(uint256 shares) external returns (uint256 assets);
    function unstake(address receiver) external;
}

/// @title EthenaBasisAdapter — the FARMARE Alpha engine's on-chain basis venue
/// @notice Turns the vault's USDC into a delta-neutral basis position by holding
/// Ethena sUSDe (itself a tokenized long-staked-ETH / short-perp book). Flow:
///   deposit:  USDC → (Curve) USDe → stake → sUSDe
///   withdraw: sUSDe → USDe → (Curve) USDC → vault
/// Containment is identical to every FARMARE adapter: funds can only move
/// vault → venue → vault, and only the vault (via the keeper) can call it.
///
/// v0 — foundation. Leverage (adaptive 1–3x via a lending loop) and the
/// crisis-guard flatten-to-Prudent routing live in the keeper, on top of this.
/// NOT audited; do not hold third-party funds before external review.
contract EthenaBasisAdapter is IVenueAdapter {
    using SafeERC20 for IERC20;

    IERC20 public immutable token;      // USDC (the vault's unit of account)
    IERC20 public immutable usde;       // Ethena USDe
    IStakedUSDe public immutable susde; // Ethena sUSDe (ERC-4626 on USDe)
    ICurveStableSwap public immutable pool;
    address public immutable vault;

    int128 private immutable iUSDC;     // pool coin index of USDC
    int128 private immutable iUSDE;     // pool coin index of USDe
    uint8 private immutable usdcDec;

    /// Max swap slippage the keeper may accept, in bps (owner-immutable here,
    /// bounded tight because both legs are stablecoins). Guards against a
    /// sandwich or a depegged pool: a swap worse than this reverts.
    uint16 public constant MAX_SLIP_BPS = 50; // 0.50%

    error NotVault();
    error NotKeeper();
    error BadPool();

    modifier onlyVault() {
        if (msg.sender != vault) revert NotVault();
        _;
    }

    constructor(
        IERC20 usdc_,
        IERC20 usde_,
        IStakedUSDe susde_,
        ICurveStableSwap pool_,
        address vault_
    ) {
        token = usdc_;
        usde = usde_;
        susde = susde_;
        pool = pool_;
        vault = vault_;
        if (address(susde_.asset()) != address(usde_)) revert BadPool();

        // resolve pool coin indices once
        address c0 = pool_.coins(0);
        address c1 = pool_.coins(1);
        if (c0 == address(usdc_) && c1 == address(usde_)) {
            (iUSDC, iUSDE) = (int128(0), int128(1));
        } else if (c1 == address(usdc_) && c0 == address(usde_)) {
            (iUSDC, iUSDE) = (int128(1), int128(0));
        } else {
            revert BadPool();
        }
        usdcDec = IERC20Meta(address(usdc_)).decimals();
    }

    function asset() external view returns (address) {
        return address(token);
    }

    /// @notice Value of the held sUSDe, in USDC terms (USDe ≈ $1 stablecoin).
    function totalAssets() public view returns (uint256) {
        uint256 usdeHeld = susde.convertToAssets(susde.balanceOf(address(this)))
            + usde.balanceOf(address(this));
        // USDe is 18-dec; USDC is `usdcDec`. USDe≈USDC 1:1 for accounting.
        return _to6(usdeHeld) + token.balanceOf(address(this));
    }

    function deposit(uint256 assets) external onlyVault {
        token.safeTransferFrom(vault, address(this), assets);
        // USDC → USDe on Curve, min-out bounded to MAX_SLIP_BPS off 1:1
        token.forceApprove(address(pool), assets);
        uint256 minUsde = _from6(assets) * (10_000 - MAX_SLIP_BPS) / 10_000;
        uint256 outUsde = pool.exchange(iUSDC, iUSDE, assets, minUsde);
        // stake USDe → sUSDe
        usde.forceApprove(address(susde), outUsde);
        susde.deposit(outUsde, address(this));
    }

    /// @notice Instant withdraw path — works while Ethena cooldown is 0.
    /// When cooldown > 0, the keeper uses {startCooldown}/{finishCooldown}.
    function withdraw(uint256 assets) external onlyVault returns (uint256) {
        if (assets == 0) return 0;
        // free USDC already on hand first
        uint256 onHand = token.balanceOf(address(this));
        if (onHand >= assets) {
            token.safeTransfer(vault, assets);
            return assets;
        }
        uint256 need = assets - onHand;
        if (susde.cooldownDuration() == 0) {
            // redeem the sUSDe needed for `need` USDe, then swap to USDC
            uint256 needUsde = _from6(need);
            uint256 held = susde.convertToAssets(susde.balanceOf(address(this)));
            if (needUsde > held) needUsde = held;
            if (needUsde > 0) {
                susde.withdraw(needUsde, address(this), address(this));
                uint256 bal = usde.balanceOf(address(this));
                usde.forceApprove(address(pool), bal);
                uint256 minUsdc = _to6(bal) * (10_000 - MAX_SLIP_BPS) / 10_000;
                pool.exchange(iUSDE, iUSDC, bal, minUsdc);
            }
        }
        uint256 pay = token.balanceOf(address(this));
        if (pay > assets) pay = assets;
        token.safeTransfer(vault, pay);
        return pay; // may be < assets if cooling down — vault handles partials
    }

    // --- keeper helpers for the cooldown path (only move funds toward exit).
    // The keeper is read live from the vault, so rotating it there rotates it
    // here; none of these can move funds anywhere but back toward the vault. ---
    modifier onlyKeeper() {
        if (msg.sender != IVaultRoles(vault).keeper()) revert NotKeeper();
        _;
    }

    function startCooldown(uint256 shares) external onlyKeeper {
        susde.cooldownShares(shares);
    }

    function finishCooldown() external onlyKeeper {
        susde.unstake(address(this)); // USDe lands here
    }

    /// @notice Swap matured-cooldown USDe → USDC so `withdraw` can pay the vault.
    function swapToUsdc(uint256 usdeAmount) external onlyKeeper {
        uint256 bal = usde.balanceOf(address(this));
        if (usdeAmount > bal) usdeAmount = bal;
        if (usdeAmount == 0) return;
        usde.forceApprove(address(pool), usdeAmount);
        uint256 minOut = _to6(usdeAmount) * (10_000 - MAX_SLIP_BPS) / 10_000;
        pool.exchange(iUSDE, iUSDC, usdeAmount, minOut);
    }

    // --- decimals helpers (USDC `usdcDec` ⇄ USDe 18) ---
    function _from6(uint256 a) private view returns (uint256) {
        return a * (10 ** (18 - usdcDec));
    }

    function _to6(uint256 a) private view returns (uint256) {
        return a / (10 ** (18 - usdcDec));
    }
}

interface IERC20Meta {
    function decimals() external view returns (uint8);
}

interface IVaultRoles {
    function keeper() external view returns (address);
}
